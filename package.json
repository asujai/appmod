{
  "name": "appmod",
  "version": "0.2.0",
  "description": "Ask your AI agent once: your language, look and small features in the apps and sites you already use, behind one desktop shortcut, without touching the app's files.",
  "type": "module",
  "bin": { "appmod": "bin/appmod.mjs" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node bin/appmod.mjs validate --all"
  },
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "https://github.com/asujai/appmod.git" },
  "keywords": ["agent-skill", "electron", "webview2", "localization", "userscript", "personalization", "cdp"],
  "license": "MIT"
}
